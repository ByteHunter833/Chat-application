rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatDocAfter(chatId) {
      return getAfter(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatMember(chatId) {
      return signedIn() &&
        request.auth.uid in chatDoc(chatId).data.members;
    }

    function isChatMemberAfter(chatId) {
      return signedIn() &&
        request.auth.uid in chatDocAfter(chatId).data.members;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isCurrentUser(uid);
      allow update: if isCurrentUser(uid);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username == request.resource.data.username;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn()
        && (
          !chatExists(chatId) ||
          request.auth.uid in resource.data.members
        );
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && (
          request.resource.data.type == 'group' ||
          request.resource.data.members.size() == 2
        );
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if (isChatMember(chatId) || isChatMemberAfter(chatId))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId;
        allow update: if isChatMember(chatId)
          && request.resource.data.chatId == resource.data.chatId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.content == resource.data.content
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.type == resource.data.type
          && request.resource.data.mediaUrl == resource.data.mediaUrl;
        allow delete: if false;
      }
    }

    match /callInvitations/{callId} {
      allow read: if signedIn()
        && (
          resource.data.callerId == request.auth.uid ||
          resource.data.calleeId == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.callId == callId;
      allow update: if signedIn()
        && (
          resource.data.callerId == request.auth.uid ||
          resource.data.calleeId == request.auth.uid
        );
      allow delete: if false;
    }
  }
}
